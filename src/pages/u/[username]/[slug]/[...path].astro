---
export const prerender = false;

import { client } from '@/db';
import { UsersTable, ProjectsTable, DeploysTable, DeployPagesTable } from '@/db/schema';
import { decodeContent, routeCandidates } from '@/lib/deploy-files';
import { eq, and, inArray } from 'drizzle-orm';

const { username, slug, path } = Astro.params;
const candidates = routeCandidates(path || '');

const user = await client
  .select()
  .from(UsersTable)
  .where(eq(UsersTable.username, username!))
  .get();

if (!user) {
  return new Response('Not Found', { status: 404 });
}

const project = await client
  .select()
  .from(ProjectsTable)
  .where(and(
    eq(ProjectsTable.ownerId, user.id),
    eq(ProjectsTable.slug, slug!)
  ))
  .get();

if (!project) {
  return new Response('Not Found', { status: 404 });
}

const liveDeploy = await client
  .select()
  .from(DeploysTable)
  .where(and(
    eq(DeploysTable.projectId, project.id),
    eq(DeploysTable.isLive, true)
  ))
  .get();

if (!liveDeploy) {
  return new Response('No live version deployed yet.', {
    status: 404,
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

const matches = await client
  .select()
  .from(DeployPagesTable)
  .where(and(
    eq(DeployPagesTable.deployId, liveDeploy.id),
    inArray(DeployPagesTable.route, candidates)
  ))
  .all();
const page = candidates.map(route => matches.find(page => page.route === route)).find(Boolean);

if (!page) {
  return new Response('Page not found in this deploy.', {
    status: 404,
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

// A directory URL must end in / so the browser resolves relative assets correctly.
if ((page.route.endsWith('/index.html') || page.route.endsWith('/index.htm')) && !/\/index\.html?$/.test(Astro.url.pathname) && !Astro.url.pathname.endsWith('/')) {
  const target = new URL(Astro.url);
  target.pathname += '/';
  return Astro.redirect(target.pathname + target.search, 308);
}
const asset = decodeContent(page.content);
return new Response(asset.body, {
  headers: {
    'Content-Type': asset.mime,
    'X-Content-Type-Options': 'nosniff',
    'Cache-Control': 'public, max-age=0, must-revalidate',
    'X-Robots-Tag': 'noindex',
  },
});
---


