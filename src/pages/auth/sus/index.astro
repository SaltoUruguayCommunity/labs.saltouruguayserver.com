---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Conectando — Labs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #0a0a0f;
        color: #fff;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .bg-ambient {
        position: fixed;
        inset: 0;
        z-index: -10;
        background: #0a0a0f;
      }
      .bg-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 600px;
        height: 600px;
        background: rgba(99, 102, 241, 0.08);
        filter: blur(150px);
        border-radius: 50%;
        pointer-events: none;
      }

      .card-wrapper {
        width: 100%;
        max-width: 420px;
        padding: 16px;
        animation: fade-in 0.5s ease-out;
      }
      .card {
        position: relative;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 28px;
        padding: 40px 32px;
        overflow: hidden;
        backdrop-filter: blur(20px);
        box-shadow: 0 0 60px -15px rgba(0,0,0,0.7);
      }
      @media (max-width: 480px) {
        .card { padding: 32px 20px; border-radius: 20px; }
      }

      .loading-bar-track {
        position: absolute;
        top: 0;
        left: 0;
        height: 3px;
        width: 100%;
        background: rgba(255,255,255,0.03);
        overflow: hidden;
      }
      .loading-bar {
        height: 100%;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        animation: loading-bar 1.5s infinite linear;
      }
      @keyframes loading-bar {
        0% { width: 0%; transform: translateX(-100%); }
        50% { width: 50%; }
        100% { width: 100%; transform: translateX(100%); }
      }

      .conn-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
        padding: 0 8px;
      }
      .logo-wrap {
        position: relative;
      }
      .logo-glow {
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        filter: blur(20px);
        opacity: 0.5;
      }
      .logo-glow-blue { background: rgba(99, 102, 241, 0.2); }
      .logo-glow-gold { background: rgba(250, 204, 21, 0.15); }

      .labs-logo {
        width: 64px;
        height: 64px;
        position: relative;
      }
      .labs-logo svg { width: 100%; height: 100%; }
      @media (max-width: 480px) {
        .labs-logo { width: 48px; height: 48px; }
      }

      .sus-logo {
        width: 64px;
        height: 64px;
        position: relative;
      }
      .sus-logo svg { width: 100%; height: 100%; }
      @media (max-width: 480px) {
        .sus-logo { width: 48px; height: 48px; }
      }

      .conn-dots {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }
      .conn-dots-row {
        display: flex;
        gap: 4px;
      }
      .conn-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6366f1;
      }
      .conn-dot:nth-child(1) { animation: dot-pulse 1.4s ease-in-out 0s infinite; }
      .conn-dot:nth-child(2) { animation: dot-pulse 1.4s ease-in-out 0.2s infinite; }
      .conn-dot:nth-child(3) { animation: dot-pulse 1.4s ease-in-out 0.4s infinite; }
      @keyframes dot-pulse {
        0%, 100% { opacity: 0.2; }
        50% { opacity: 1; }
      }
      .conn-arrow {
        color: rgba(99, 102, 241, 0.4);
        width: 20px;
        height: 20px;
      }

      .title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }
      .subtitle {
        color: rgba(255,255,255,0.7);
        font-weight: 500;
        font-size: 14px;
      }
      .desc {
        color: rgba(255,255,255,0.35);
        font-size: 12px;
        line-height: 1.6;
        max-width: 280px;
        margin: 0 auto;
      }
      .footer-text {
        text-align: center;
        margin-top: 24px;
        font-size: 10px;
        font-family: monospace;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: rgba(255,255,255,0.12);
      }

      .spinner {
        width: 22px;
        height: 22px;
        border: 2.5px solid rgba(99,102,241,0.2);
        border-top-color: #6366f1;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: inline-block;
        vertical-align: middle;
      }
      @keyframes spin { to { transform: rotate(360deg); } }

      @keyframes fade-in {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
      }
    </style>
  </head>
  <body>
    <div class="bg-ambient">
      <div class="bg-glow"></div>
    </div>

    <div class="card-wrapper">
      <div class="card">
        <div class="loading-bar-track">
          <div class="loading-bar"></div>
        </div>

        <div class="conn-row">
          <div class="logo-wrap">
            <div class="logo-glow logo-glow-blue"></div>
            <div class="labs-logo">
              <svg viewBox="0 0 64 64" fill="none">
                <rect x="4" y="4" width="56" height="56" rx="14" fill="rgba(99,102,241,0.08)" stroke="rgba(99,102,241,0.25)" stroke-width="1.5"/>
                <text x="32" y="40" text-anchor="middle" fill="#6366f1" font-family="Space Grotesk, sans-serif" font-size="26" font-weight="700">L</text>
              </svg>
            </div>
          </div>

          <div class="conn-dots">
            <div class="conn-dots-row">
              <div class="conn-dot"></div>
              <div class="conn-dot"></div>
              <div class="conn-dot"></div>
            </div>
            <svg class="conn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>

          <div class="logo-wrap">
            <div class="logo-glow logo-glow-gold"></div>
            <div class="sus-logo">
              <svg viewBox="0 0 64 64" fill="none">
                <circle cx="32" cy="32" r="28" fill="rgba(250,204,21,0.06)" stroke="rgba(250,204,21,0.2)" stroke-width="1.5"/>
                <text x="32" y="39" text-anchor="middle" fill="#facc15" font-family="Space Grotesk, sans-serif" font-size="24" font-weight="600">SUS</text>
              </svg>
            </div>
          </div>
        </div>

        <div style="text-align: center; display: flex; flex-direction: column; gap: 16px;">
          <h1 class="title">
            <span class="spinner"></span>
            Conectando...
          </h1>

          <div style="display: flex; flex-direction: column; gap: 6px;">
            <p class="subtitle">Solicitando acceso a SaltoUruguayServer</p>
            <p class="desc">
              Conectá tu cuenta para administrar y publicar proyectos en Labs.
            </p>
          </div>
        </div>
      </div>

      <p class="footer-text">Redireccionando de forma segura</p>
    </div>

    <script>
      import { signIn } from "auth-astro/client";

      setTimeout(() => {
        signIn("saltouruguay", { callbackUrl: "/auth/sus/callback" });
      }, 600);
    </script>
  </body>
</html>
