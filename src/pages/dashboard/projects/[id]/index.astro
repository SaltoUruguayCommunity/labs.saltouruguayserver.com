---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import { client } from '@/db';
import { ProjectsTable, DeploysTable, DeployPagesTable, UsersTable } from '@/db/schema';
import { eq, desc, asc } from 'drizzle-orm';

const user = Astro.locals.user;

if (!user || !user.is_admin) {
  return Astro.redirect('/');
}

const projectId = Number(Astro.params.id);

const dbUser = await client
  .select()
  .from(UsersTable)
  .where(eq(UsersTable.susId, Number(user.id)))
  .get();

if (!dbUser) {
  return Astro.redirect('/');
}

const project = await client
  .select()
  .from(ProjectsTable)
  .where(eq(ProjectsTable.id, projectId))
  .get();

if (!project || project.ownerId !== dbUser.id) {
  return Astro.redirect('/dashboard');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = Astro.url.searchParams.get('action');

  if (action === 'set-live') {
    const version = Number(formData.get('version'));
    const deploysAll = await client.select().from(DeploysTable).where(eq(DeploysTable.projectId, projectId)).all();
    for (const d of deploysAll) {
      await client.update(DeploysTable).set({ isLive: d.version === version }).where(eq(DeploysTable.id, d.id)).run();
    }
    return Astro.redirect(`/dashboard/projects/${projectId}`);
  }

  if (action === 'unpublish') {
    const deploysAll = await client.select().from(DeploysTable).where(eq(DeploysTable.projectId, projectId)).all();
    for (const d of deploysAll) {
      await client.update(DeploysTable).set({ isLive: false }).where(eq(DeploysTable.id, d.id)).run();
    }
    return Astro.redirect(`/dashboard/projects/${projectId}`);
  }

  if (action === 'delete-deploy') {
    const deployId = Number(formData.get('deployId'));
    const deploy = await client.select().from(DeploysTable).where(eq(DeploysTable.id, deployId)).get();
    if (deploy && !deploy.isLive) {
      await client.delete(DeployPagesTable).where(eq(DeployPagesTable.deployId, deployId)).run();
      await client.delete(DeploysTable).where(eq(DeploysTable.id, deployId)).run();
    }
    return Astro.redirect(`/dashboard/projects/${projectId}`);
  }

  if (action === 'delete-project') {
    await client.delete(DeployPagesTable).where(eq(DeployPagesTable.deployId, projectId)).run();
    await client.delete(DeploysTable).where(eq(DeploysTable.projectId, projectId)).run();
    await client.delete(ProjectsTable).where(eq(ProjectsTable.id, projectId)).run();
    return Astro.redirect('/dashboard');
  }
}

const deploys = await client
  .select()
  .from(DeploysTable)
  .where(eq(DeploysTable.projectId, projectId))
  .orderBy(desc(DeploysTable.version))
  .all();

const deployIds = deploys.map(d => d.id);

const allPages = deployIds.length > 0
  ? await client.select().from(DeployPagesTable).orderBy(asc(DeployPagesTable.route)).all()
  : [];

const pagesByDeploy = new Map<number, typeof allPages>();
for (const p of allPages) {
  const list = pagesByDeploy.get(p.deployId) || [];
  list.push(p);
  pagesByDeploy.set(p.deployId, list);
}

const liveDeploy = deploys.find(d => d.isLive);
const liveUrl = `/u/${dbUser.username}/${project.slug}`;
---

<AdminLayout title={project.name}>
  <div class="mx-auto max-w-4xl">
    <div class="mb-8">
      <a href="/dashboard" class="mb-4 inline-flex items-center gap-1.5 text-sm text-text-muted no-underline transition-colors hover:text-text-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Volver al dashboard
      </a>

      <div class="mt-2 flex items-start justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl font-bold tracking-tight">{project.name}</h1>
          <p class="mt-1 text-text-muted">
            {liveDeploy ? (
              <a href={liveUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-text-secondary no-underline transition-colors hover:text-accent">
                {liveUrl}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/>
                </svg>
              </a>
            ) : (
              <span>/u/{dbUser.username}/{project.slug}</span>
            )}
            {liveDeploy && (
              <span class="ml-2 inline-flex items-center gap-1 text-success">
                <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                Live (v{liveDeploy.version})
              </span>
            )}
          </p>
        </div>
        <div class="flex items-center gap-2">
          {liveDeploy && (
            <>
              <form method="POST" action={`/dashboard/projects/${projectId}?action=unpublish`} class="shrink-0">
                <button
                  type="submit"
                  class="inline-flex items-center gap-2 rounded-[14px] border border-warning/30 bg-warning/5 px-4 py-2.5 text-sm font-medium text-warning no-underline transition-all hover:bg-warning/10 cursor-pointer"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                    <line x1="2" x2="22" y1="2" y2="22"/>
                  </svg>
                  Quitar live
                </button>
              </form>
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener"
                class="shrink-0 inline-flex items-center gap-2 rounded-[14px] border border-border-default bg-transparent px-4 py-2.5 text-sm font-medium text-text-secondary no-underline transition-all hover:bg-surface-card-hover hover:text-text-primary"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                Ver live
              </a>
            </>
          )}
          <a
            href={`/dashboard/projects/${projectId}/deploy`}
            class="shrink-0 inline-flex items-center gap-2 rounded-[14px] bg-accent px-5 py-2.5 text-sm font-semibold text-white no-underline transition-all hover:bg-accent-hover hover:shadow-[0_8px_30px_rgba(99,102,241,0.3)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
            </svg>
            Nuevo Deploy
          </a>
        </div>
      </div>
    </div>

    {project.description && (
      <p class="mb-6 text-text-secondary">{project.description}</p>
    )}

    {deploys.length === 0 ? (
      <div class="flex flex-col items-center justify-center rounded-[20px] border border-dashed border-border-default py-16">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-[14px] bg-surface-card">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-muted">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
          </svg>
        </div>
        <h3 class="mb-1 font-display text-lg font-semibold text-text-primary">Sin deploys</h3>
        <p class="mb-5 text-sm text-text-muted">Subi tu primer deploy para publicar tu proyecto.</p>
        <a
          href={`/dashboard/projects/${projectId}/deploy`}
          class="inline-flex items-center gap-2 rounded-[12px] bg-accent px-4 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-accent-hover"
        >
          Subir deploy
        </a>
      </div>
    ) : (
      <div class="flex flex-col gap-4">
        {deploys.map((deploy) => {
          const pages = pagesByDeploy.get(deploy.id) || [];
          return (
            <div class="rounded-[16px] border border-border-subtle bg-surface-card overflow-hidden">
              <div class="flex items-center gap-3 p-4">
                <div class:list={[
                  "flex h-10 w-10 items-center justify-center rounded-[10px] text-sm font-bold shrink-0",
                  deploy.isLive ? "bg-success/10 text-success" : "bg-surface-elevated text-text-secondary"
                ]}>
                  v{deploy.version}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-medium text-text-primary">Version {deploy.version}</span>
                    {deploy.isLive && (
                      <span class="rounded-full bg-success/10 px-2 py-0.5 text-xs font-medium text-success">Live</span>
                    )}
                  </div>
                  <p class="text-xs text-text-muted">{pages.length} pagina{pages.length !== 1 ? 's' : ''}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  {!deploy.isLive && (
                    <form method="POST" action={`/dashboard/projects/${projectId}?action=set-live`}>
                      <input type="hidden" name="version" value={deploy.version} />
                      <button
                        type="submit"
                        class="rounded-[10px] border border-border-default bg-transparent px-3 py-1.5 text-xs font-medium text-text-secondary transition-colors hover:bg-surface-card-hover hover:text-text-primary cursor-pointer"
                      >
                        Set Live
                      </button>
                    </form>
                  )}
                  {!deploy.isLive && (
                    <form method="POST" action={`/dashboard/projects/${projectId}?action=delete-deploy`}>
                      <input type="hidden" name="deployId" value={deploy.id} />
                      <button
                        type="submit"
                        class="flex h-8 w-8 items-center justify-center rounded-[8px] border border-border-subtle bg-transparent text-text-muted transition-colors hover:border-danger/30 hover:bg-danger/5 hover:text-danger cursor-pointer"
                        title="Eliminar deploy"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                      </button>
                    </form>
                  )}
                </div>
              </div>

              {pages.length > 0 && (
                <div class="border-t border-border-subtle">
                  <div class="px-4 py-2">
                    <p class="text-[11px] font-medium uppercase tracking-wider text-text-faint">Archivos</p>
                  </div>
                  <div class="divide-y divide-border-subtle">
                    {pages.map((page) => (
                      <div class="flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-surface-card-hover">
                        <div class="flex h-6 w-6 items-center justify-center rounded-[6px] bg-accent/8 text-accent">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
                          </svg>
                        </div>
                        <span class="flex-1 text-sm text-text-primary font-mono">{page.route}</span>
                        <span class="text-xs text-text-faint">{(page.content.length / 1024).toFixed(1)} KB</span>
                        {deploy.isLive && (
                          <a
                            href={page.route === '/' ? liveUrl : `${liveUrl}${page.route}`}
                            target="_blank"
                            rel="noopener"
                            class="flex h-6 w-6 items-center justify-center rounded-[6px] text-text-faint transition-colors hover:bg-accent/10 hover:text-accent"
                            title="Abrir en nueva pestana"
                          >
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/>
                            </svg>
                          </a>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>
    )}

    {deploys.length > 0 && (
      <div class="mt-12 border-t border-border-subtle pt-8">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-display text-lg font-semibold text-text-primary">Zona de peligro</h3>
            <p class="text-sm text-text-muted">Eliminar este proyecto es permanente.</p>
          </div>
          <form method="POST" action={`/dashboard/projects/${projectId}?action=delete-project`} id="deleteProjectForm">
            <button
              type="button"
              id="deleteProjectBtn"
              class="inline-flex items-center gap-2 rounded-[14px] border border-danger/30 bg-danger/5 px-5 py-2.5 text-sm font-medium text-danger transition-all hover:bg-danger/10 cursor-pointer"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
              </svg>
              Eliminar proyecto
            </button>
          </form>
        </div>
      </div>
    )}
  </div>

  <script>
    document.getElementById("deleteProjectBtn")?.addEventListener("click", () => {
      if (confirm("Eliminar este proyecto y todos sus deploys? Esta accion no se puede deshacer.")) {
        document.getElementById("deleteProjectForm")?.requestSubmit();
      }
    });
  </script>
</AdminLayout>
