---
export const prerender = false;

import { Buffer } from 'node:buffer';
import Icon from '@/components/Icon.astro';
import '@/styles/deployments.css';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { client } from '@/db';
import { ProjectsTable, DeploysTable, DeployPagesTable, UsersTable } from '@/db/schema';
import { eq, desc, asc, inArray, and } from 'drizzle-orm';

const user = Astro.locals.user;

if (!user || !user.is_admin) {
  return Astro.redirect('/');
}

const projectId = Number(Astro.params.id);

const dbUser = await client
  .select()
  .from(UsersTable)
  .where(eq(UsersTable.susId, Number(user.id)))
  .get();

if (!dbUser) {
  return Astro.redirect('/');
}

const project = await client
  .select()
  .from(ProjectsTable)
  .where(eq(ProjectsTable.id, projectId))
  .get();

if (!project || project.ownerId !== dbUser.id) {
  return Astro.redirect('/dashboard');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = Astro.url.searchParams.get('action');

  if (action === 'set-live') {
    const version = Number(formData.get('version'));
    const target = await client.select({ id: DeploysTable.id }).from(DeploysTable).where(and(eq(DeploysTable.projectId, projectId), eq(DeploysTable.version, version))).get();
    if (!target) return Astro.redirect('/dashboard/projects/' + projectId);
    const deploysAll = await client.select().from(DeploysTable).where(eq(DeploysTable.projectId, projectId)).all();
    for (const d of deploysAll) {
      await client.update(DeploysTable).set({ isLive: d.version === version }).where(eq(DeploysTable.id, d.id)).run();
    }
    return Astro.redirect(`/dashboard/projects/${projectId}`);
  }

  if (action === 'unpublish') {
    const deploysAll = await client.select().from(DeploysTable).where(eq(DeploysTable.projectId, projectId)).all();
    for (const d of deploysAll) {
      await client.update(DeploysTable).set({ isLive: false }).where(eq(DeploysTable.id, d.id)).run();
    }
    return Astro.redirect(`/dashboard/projects/${projectId}`);
  }

  if (action === 'delete-deploy') {
    const deployId = Number(formData.get('deployId'));
    const deploy = await client.select().from(DeploysTable).where(eq(DeploysTable.id, deployId)).get();
    if (deploy && deploy.projectId === projectId && !deploy.isLive) {
      await client.delete(DeployPagesTable).where(eq(DeployPagesTable.deployId, deployId)).run();
      await client.delete(DeploysTable).where(eq(DeploysTable.id, deployId)).run();
    }
    return Astro.redirect(`/dashboard/projects/${projectId}`);
  }

  if (action === 'delete-project') {
    const projectDeploys = await client.select({ id: DeploysTable.id }).from(DeploysTable).where(eq(DeploysTable.projectId, projectId)).all();
    if (projectDeploys.length) await client.delete(DeployPagesTable).where(inArray(DeployPagesTable.deployId, projectDeploys.map(d => d.id))).run();
    await client.delete(DeploysTable).where(eq(DeploysTable.projectId, projectId)).run();
    await client.delete(ProjectsTable).where(eq(ProjectsTable.id, projectId)).run();
    return Astro.redirect('/dashboard');
  }
}

const deploys = await client
  .select()
  .from(DeploysTable)
  .where(eq(DeploysTable.projectId, projectId))
  .orderBy(desc(DeploysTable.version))
  .all();

const deployIds = deploys.map(d => d.id);

const allPages = deployIds.length > 0
  ? await client.select().from(DeployPagesTable).where(inArray(DeployPagesTable.deployId, deployIds)).orderBy(asc(DeployPagesTable.route)).all()
  : [];

const pagesByDeploy = new Map<number, typeof allPages>();
for (const p of allPages) {
  const list = pagesByDeploy.get(p.deployId) || [];
  list.push(p);
  pagesByDeploy.set(p.deployId, list);
}

const liveDeploy = deploys.find(d => d.isLive);
const liveUrl = `/u/${dbUser.username}/${project.slug}`;
const formatDate = (value: string) => {
  const date = new Date(value.includes('T') ? value : value.replace(' ', 'T') + 'Z');
  return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat('es-UY', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Montevideo' }).format(date);
};
const fileSize = (content: string) => {
  if (content.startsWith('labs:asset:v1:')) {
    const { data } = JSON.parse(content.slice('labs:asset:v1:'.length));
    return Buffer.byteLength(data, 'base64');
  }
  return Buffer.byteLength(content, 'utf8');
};
const sizeLabel = (bytes: number) => bytes >= 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${(bytes / 1024).toFixed(1)} KB`;
---
<AdminLayout title={`${project.name} · Deploys`}>
  <div class="deploy-manager">
    <nav class="deploy-breadcrumb" aria-label="Ruta del proyecto"><a href="/dashboard">Proyectos</a><span>/</span><span>{project.name}</span></nav>
    <div class="page-heading deploy-heading"><div><span class="eyebrow">DEL EXPERIMENTO A PRODUCCIÓN</span><h1>{project.name}<span class="brand-dot">.</span></h1><p>{project.description || 'Cada versión, un paso más cerca de tu próxima gran idea.'}</p></div><a class="button" href={`/dashboard/projects/${projectId}/deploy`}><Icon name="upload" size={17} /> Nuevo deploy</a></div>
    <div class="deploy-section-nav"><span class="selected"><Icon name="layers" size={16} /> Deploys <b>{deploys.length}</b></span><span>Historial de versiones</span></div>
    <section class:list={['production-panel', { 'is-live': !!liveDeploy }]} aria-labelledby="production-heading">
      <div class="production-overview"><div class="production-globe"><Icon name="globe" size={26} /></div><div><span class="eyebrow">PRODUCCIÓN</span><h2 id="production-heading">{liveDeploy ? 'Tu proyecto está en línea.' : 'Listo para tu próximo lanzamiento.'}</h2><p>{liveDeploy ? 'Esta es la versión que ve quien visita tu web.' : 'Elegí una versión del historial para publicar tu web.'}</p></div><span class:list={['status-badge', { published: !!liveDeploy }]}><i></i>{liveDeploy ? 'Publicado' : 'Sin publicar'}</span></div>
      <div class="production-meta"><div><span>Dirección del proyecto</span>{liveDeploy ? <a class="production-address" href={liveUrl + '/'} target="_blank" rel="noopener">{liveUrl}/ <Icon name="arrow" size={14} /></a> : <p class="production-address">{liveUrl}/</p>}</div><div><span>Versión activa</span><p>{liveDeploy ? `v${liveDeploy.version}` : '—'}</p></div><div><span>Creada</span><p>{liveDeploy ? formatDate(liveDeploy.createdAt) : 'Esperando publicación'}</p></div></div>
      {liveDeploy && <div class="production-actions"><a href={liveUrl + '/'} target="_blank" rel="noopener" class="button button-secondary button-small">Visitar web <Icon name="arrow" size={14} /></a><form method="POST" action={`?action=unpublish`} data-confirm="¿Quitar la web de producción? Tus versiones se conservarán."><button type="submit" class="quiet-button">Quitar de producción</button></form><span><span class="tiny-dot"></span> v{liveDeploy.version} en producción</span></div>}
    </section>
    <section aria-labelledby="history-heading" class="deploy-history">
      <div class="projects-heading"><h2 id="history-heading">Historial de deploys <span>{deploys.length}</span></h2><span class="muted-caption">La última versión aparece primero.</span></div>
      {deploys.length > 0 && <div class="project-toolbar"><label class="search-field"><Icon name="search" size={17} /><span class="sr-only">Buscar versión</span><input id="deploy-search" type="search" placeholder="Buscar versión, archivo o fecha…" /></label><div class="filter-buttons" role="group" aria-label="Filtrar versiones"><button data-deploy-filter="all" aria-pressed="true">Todas</button><button data-deploy-filter="live" aria-pressed="false">En producción</button><button data-deploy-filter="saved" aria-pressed="false">Guardadas</button></div></div>}
      {deploys.length === 0 ? <div class="empty-projects"><span class="empty-icon"><Icon name="upload" size={32} /></span><span class="eyebrow">TU HISTORIAL EMPIEZA ACÁ</span><h2>Primero un deploy. Después, el mundo.</h2><p>Subí un ZIP con tu web o tus archivos HTML.<br />La versión se guardará hasta que decidas publicarla.</p><a href={`/dashboard/projects/${projectId}/deploy`} class="button"><Icon name="plus" size={16} /> Subir mi primer deploy</a></div> : <div class="deployment-list">{deploys.map((deploy, index) => {
        const pages = pagesByDeploy.get(deploy.id) || [];
        const total = pages.reduce((sum, page) => sum + fileSize(page.content), 0);
        return <article class:list={['deployment-card', { 'deployment-live': deploy.isLive }]} data-deployment data-state={deploy.isLive ? 'live' : 'saved'} data-search={`v${deploy.version} versión ${deploy.version} ${formatDate(deploy.createdAt)} ${pages.map(p => p.route).join(' ')}`.toLocaleLowerCase()}>
          <div class="deployment-row"><div class="deployment-version"><Icon name="layers" size={19} /><strong>v{deploy.version}</strong></div><div class="deployment-description"><div><h3>Versión {deploy.version}</h3><span class:list={['status-badge', { published: deploy.isLive }]}><i></i>{deploy.isLive ? 'En producción' : 'Guardada'}</span>{index === 0 && <span class="latest-label">Más reciente</span>}</div><p><time datetime={deploy.createdAt}>{formatDate(deploy.createdAt)}</time><span>·</span>{pages.length} {pages.length === 1 ? 'archivo' : 'archivos'}<span>·</span>{sizeLabel(total)}</p></div><div class="deployment-actions">{deploy.isLive ? <a class="button button-secondary button-small" href={liveUrl + '/'} target="_blank" rel="noopener">Visitar <Icon name="arrow" size={14} /></a> : <><form method="POST" action="?action=set-live"><input type="hidden" name="version" value={deploy.version} /><button class="button button-secondary button-small" type="submit"><Icon name="globe" size={14} /> {liveDeploy && deploy.version < liveDeploy.version ? 'Restaurar versión' : 'Publicar versión'}</button></form><form method="POST" action="?action=delete-deploy" data-confirm={`¿Eliminar la versión ${deploy.version} y sus archivos? Esta acción no se puede deshacer.`}><input type="hidden" name="deployId" value={deploy.id} /><button class="deploy-delete" type="submit" aria-label={`Eliminar versión ${deploy.version}`} title="Eliminar versión"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg></button></form></>}</div></div>
          <details class="deployment-files"><summary><Icon name="code" size={14} /><span>Explorar archivos</span><span class="file-count">{pages.length}</span><span class="details-chevron">⌄</span></summary><div class="deployment-file-list">{pages.map(page => <div class="deployment-file"><Icon name="code" size={14} /><code>{page.route}</code><span>{sizeLabel(fileSize(page.content))}</span>{deploy.isLive && <a href={page.route === '/' ? liveUrl + '/' : liveUrl + page.route.split('/').map(encodeURIComponent).join('/')} target="_blank" rel="noopener" aria-label={`Abrir ${page.route}`}><Icon name="arrow" size={14} /></a>}</div>)}</div></details>
        </article>;
      })}</div>}
      <p id="deploy-no-results" class="no-results" role="status" hidden>No hay versiones que coincidan con tu búsqueda.</p><p class="sr-only" id="deploy-result-count" aria-live="polite"></p>
    </section>
    <aside class="help-strip"><span class="project-icon"><Icon name="layers" size={20} /></span><div><h3>Probá sin perder el camino.</h3><p>Cada deploy conserva sus archivos. Podés volver a publicar una versión anterior en cualquier momento.</p></div></aside>
    <details class="project-settings"><summary>Administrar proyecto <span>⌄</span></summary><div class="project-danger"><div><h3>Eliminar proyecto</h3><p>Se eliminarán el proyecto y todas sus versiones de forma permanente.</p></div><form method="POST" action="?action=delete-project" data-confirm={`¿Eliminar ${project.name} y todos sus deploys? Esta acción no se puede deshacer.`}><button type="submit" class="deploy-danger-button">Eliminar proyecto</button></form></div></details>
  </div>
  <script>
    const deployments = Array.from(document.querySelectorAll<HTMLElement>('[data-deployment]'));
    const search = document.querySelector<HTMLInputElement>('#deploy-search');
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-deploy-filter]');
    let state = 'all';
    function update() {
      const query = (search?.value || '').trim().toLocaleLowerCase();
      let count = 0;
      deployments.forEach(deploy => { const visible = (state === 'all' || deploy.dataset.state === state) && (deploy.dataset.search || '').includes(query); deploy.hidden = !visible; if (visible) count++; });
      const empty = document.getElementById('deploy-no-results');
      if (empty) empty.hidden = count > 0 || deployments.length === 0;
      const status = document.getElementById('deploy-result-count');
      if (status) status.textContent = `${count} versiones encontradas`;
    }
    search?.addEventListener('input', update);
    filters.forEach(button => button.addEventListener('click', () => { state = button.dataset.deployFilter || 'all'; filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button))); update(); }));
    document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach(form => form.addEventListener('submit', event => { if (!confirm(form.dataset.confirm || '¿Continuar con esta acción?')) event.preventDefault(); }));
  </script>
</AdminLayout>
