---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { client } from '@/db';
import { ProjectsTable, DeploysTable, UsersTable } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;

if (!user || !user.is_admin) {
  return Astro.redirect('/');
}

const projects = await client
  .select({
    id: ProjectsTable.id,
    name: ProjectsTable.name,
    slug: ProjectsTable.slug,
    description: ProjectsTable.description,
    ownerUsername: UsersTable.username,
    createdAt: ProjectsTable.createdAt,
  })
  .from(ProjectsTable)
  .innerJoin(UsersTable, eq(ProjectsTable.ownerId, UsersTable.id))
  .orderBy(desc(ProjectsTable.updatedAt))
  .all();

const projectIds = projects.map(p => p.id);
const deployCounts = projectIds.length > 0
  ? await client
      .select({
        projectId: DeploysTable.projectId,
        count: DeploysTable.id,
      })
      .from(DeploysTable)

      .all()
  : [];

const liveDeploys = projectIds.length > 0
  ? await client
      .select({
        projectId: DeploysTable.projectId,
        version: DeploysTable.version,
      })
      .from(DeploysTable)
      .where(eq(DeploysTable.isLive, true))
      .all()
  : [];

const deployCountMap = new Map<number, number>();
for (const d of deployCounts) {
  deployCountMap.set(d.projectId, (deployCountMap.get(d.projectId) || 0) + 1);
}

const liveMap = new Map<number, number>();
for (const d of liveDeploys) {
  liveMap.set(d.projectId, d.version);
}
---

<AdminLayout title="Proyectos">
  <div class="page-heading"><div><span class="eyebrow">TU ESPACIO DE CREACIÓN</span><h1>Proyectos<span class="brand-dot">.</span></h1><p>De una idea suelta a tu próxima web. Todo empieza acá.</p></div><a href="/dashboard/projects/new" class="button"><Icon name="plus" size={18} /> Nuevo proyecto</a></div>
  <section class="stats-grid" aria-label="Resumen de proyectos"><div><span class="stat-icon"><Icon name="grid" /></span><span>Proyectos<strong>{projects.length.toString().padStart(2, '0')}</strong></span></div><div><span class="stat-icon green"><Icon name="globe" /></span><span>En producción<strong>{projects.filter(p => liveMap.has(p.id)).length.toString().padStart(2, '0')}</strong></span></div><div><span class="stat-icon blue"><Icon name="layers" /></span><span>Deploys totales<strong>{deployCounts.length.toString().padStart(2, '0')}</strong></span></div></section>
  <section class="project-section" aria-labelledby="projects-heading">
    <div class="projects-heading"><h2 id="projects-heading">Tus experimentos <span>{projects.length}</span></h2><span class="muted-caption">Un lugar para cada idea.</span></div>
    {projects.length > 0 && <div class="project-toolbar"><label class="search-field"><Icon name="search" size={18} /><span class="sr-only">Buscar proyectos</span><input id="project-search" type="search" placeholder="Buscar un proyecto…" /></label><div class="filter-buttons" role="group" aria-label="Filtrar por publicación"><button data-filter="all" aria-pressed="true">Todos</button><button data-filter="live" aria-pressed="false">Publicados</button><button data-filter="draft" aria-pressed="false">Sin publicar</button></div></div>}
    {projects.length === 0 ? <div class="empty-projects"><span class="empty-icon"><Icon name="code" size={36} /></span><span class="eyebrow">EL COMIENZO DE ALGO BUENO</span><h2>Tu próxima idea vive acá.</h2><p>Una web, una herramienta o ese experimento que tenés pendiente.<br />Creá tu primer proyecto y dale un lugar en internet.</p><a href="/dashboard/projects/new" class="button"><Icon name="plus" size={17} /> Crear mi primer proyecto</a><span class="empty-note">Creá el proyecto · Subí tus HTML · Publicá tu versión</span></div> : <div class="projects-grid">{projects.map(project => <ProjectCard name={project.name} slug={project.slug} description={project.description} ownerUsername={project.ownerUsername} deployCount={deployCountMap.get(project.id) || 0} liveVersion={liveMap.get(project.id) ?? null} href={`/dashboard/projects/${project.id}`} />)}</div>}
    <p id="no-results" class="no-results" hidden>No encontramos proyectos con esos filtros. Probá con otra búsqueda.</p>
    <p id="result-count" class="sr-only" aria-live="polite"></p>
  </section>
  <aside class="help-strip"><span class="project-icon"><Icon name="upload" /></span><div><h3>Del archivo a la web, sin vueltas.</h3><p>Subí tus HTML, gestioná versiones y elegí cuál compartir con la comunidad.</p></div><a href="/#como-funciona">Cómo funciona <Icon name="arrow" size={16} /></a></aside>
  <script>
    const search = document.querySelector<HTMLInputElement>('#project-search');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    let selected = 'all';
    function updateProjects() {
      const query = (search?.value || '').trim().toLocaleLowerCase();
      let count = 0;
      cards.forEach(card => { const visible = (card.dataset.search || '').includes(query) && (selected === 'all' || card.dataset.status === selected); card.hidden = !visible; if (visible) count++; });
      const empty = document.querySelector<HTMLElement>('#no-results');
      if (empty) empty.hidden = count > 0 || cards.length === 0;
      const status = document.querySelector('#result-count');
      if (status) status.textContent = `${count} proyectos encontrados`;
    }
    search?.addEventListener('input', updateProjects);
    filters.forEach(button => button.addEventListener('click', () => { selected = button.dataset.filter || 'all'; filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button))); updateProjects(); }));
  </script>
</AdminLayout>
