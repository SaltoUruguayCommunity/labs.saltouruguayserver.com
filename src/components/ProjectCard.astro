---
import Icon from './Icon.astro';
interface Props { name: string; slug: string; description?: string | null; ownerUsername: string; deployCount: number; liveVersion?: number | null; href: string; }
const { name, slug, description, ownerUsername, deployCount, liveVersion, href } = Astro.props;
const liveUrl = `/u/${ownerUsername}/${slug}`;
---
<article class="project-card" data-project data-search={`${name} ${slug} ${description || ''} ${ownerUsername}`.toLowerCase()} data-status={liveVersion != null ? 'live' : 'draft'}>
  <div class="project-top"><span class="project-icon"><Icon name="code" size={22} /></span><span class:list={['status-badge', { published: liveVersion != null }]}><i></i>{liveVersion != null ? 'Publicado' : 'Sin publicar'}</span></div>
  <h2><a href={href}>{name}</a></h2>
  <p class="project-url">{liveUrl}</p>
  <p class="project-description">{description || 'Un nuevo experimento. Todo listo para tu próxima idea.'}</p>
  <div class="project-release"><Icon name="layers" size={15} /><span>{deployCount} {deployCount === 1 ? 'deploy' : 'deploys'}</span><span class="release-version">{liveVersion != null ? `Producción · v${liveVersion}` : 'Esperando el primer lanzamiento'}</span></div>
  <div class="project-bottom"><a href={href}>Gestionar proyecto <span>→</span></a>{liveVersion != null && <a href={liveUrl} target="_blank" rel="noopener" aria-label={`Abrir ${name}`} title="Abrir web publicada"><Icon name="arrow" size={18} /></a>}</div>
</article>
