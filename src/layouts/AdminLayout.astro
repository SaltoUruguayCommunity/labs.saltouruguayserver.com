---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props { title: string; description?: string; }
const { title, description = 'Publicá y gestioná tus proyectos web en Salto Uruguay Server.' } = Astro.props;
const user = Astro.locals.user;
const isDashboard = Astro.url.pathname.startsWith('/dashboard');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Labs · Salto Uruguay</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/salto.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Ir al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Labs, inicio"><img src="/salto.svg" alt="" width="32" height="32" /><span class="brand-divider">/</span><strong>labs<span class="brand-dot">.</span></strong><span class="beta-label">BETA</span></a>
        <div class="header-actions"><a class="community-link" href="https://saltouruguayserver.com" target="_blank" rel="noopener">Salto Uruguay <Icon name="arrow" size={14} /></a>
          {user ? <><span class="user-chip"><span class="avatar">{(user.username || user.name || 'U').slice(0, 1).toUpperCase()}</span><span>{user.username || user.name}</span></span><button id="logoutBtn" class="quiet-button">Salir</button></> : <a href="/auth/sus" class="button button-small">Ingresar <Icon name="arrow" size={15} /></a>}
        </div>
      </div>
      <nav class="workspace-nav" aria-label="Navegación principal"><a href="/dashboard" class:list={[{ active: isDashboard }]} aria-current={isDashboard ? 'page' : undefined}><Icon name="grid" size={16} /> Proyectos</a><a href="/#como-funciona">Cómo funciona <Icon name="arrow" size={13} /></a><span class="workspace-label">EL LABORATORIO DE LA COMUNIDAD</span></nav>
    </header>
    <main id="main" class="workspace-main"><slot /></main>
    <footer class="site-footer"><a href="/" class="footer-brand">labs. <span>por Salto Uruguay Server</span></a><span>Un espacio para hacer que las ideas pasen.</span><a href="https://saltouruguayserver.com" target="_blank" rel="noopener">Hecho en comunidad ↗</a></footer>
    <script>
      import { signOut } from 'auth-astro/client';
      document.getElementById('logoutBtn')?.addEventListener('click', async () => { await signOut(); });
    </script>
  </body>
</html>
